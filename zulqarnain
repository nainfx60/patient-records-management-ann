    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, fbeta_score, confusion_matrix, classification_report\n",
    "\n",
    "\n",
    "FILE_NAME = \"patients.csv\"\n",
    "\n",
    "if not os.path.exists(FILE_NAME):\n",
    "    print(f\" Error: '{FILE_NAME}' file nahi mili! Meharbani karke check karein ke file isi folder mein ho.\")\n",
    "else:\n",
    "    df = pd.read_csv(FILE_NAME)\n",
    "    print(\" Dataset successfully load !\\n\")\n",
    "   \n",
    "    df['arrival_date'] = pd.to_datetime(df['arrival_date'])\n",
    "    df['departure_date'] = pd.to_datetime(df['departure_date'])\n",
    "    df['length_of_stay'] = (df['departure_date'] - df['arrival_date']).dt.days\n",
    "   \n",
    "    df['high_satisfaction'] = (df['satisfaction'] >= 80).astype(int)\n",
    "    \n",
    "\n",
    "    X_raw = df[['age', 'length_of_stay', 'service']]\n",
    "   \n",
    "    X_encoded = pd.get_dummies(X_raw, columns=['service'], drop_first=True)\n",
    "    y = df['high_satisfaction'].values\n",
    "    \n",
    "   \n",
    "    X_train, X_test, y_train, y_test = train_test_split(X_encoded, y, test_size=0.20, random_state=42, stratify=y)\n",
    "    \n",
    "    \n",
    "    scaler = StandardScaler()\n",
    "    X_train_scaled = scaler.fit_transform(X_train)\n",
    "    X_test_scaled = scaler.transform(X_test)\n",
    "    \n",
    "\n",
    "    mlp = MLPClassifier(hidden_layer_sizes=(64, 32, 16), activation='relu', solver='adam', \n",
    "                        max_iter=300, random_state=42, early_stopping=True, validation_fraction=0.1)\n",
    "    \n",
    "  \n",
    "    mlp.fit(X_train_scaled, y_train)\n",
    "    print(\" Artificial Neural Network (ANN) Model successfully trained!\\n\")\n",
    "   \n",
    "    y_pred = mlp.predict(X_test_scaled)\n",
    "    \n",
    "    accuracy = accuracy_score(y_test, y_pred)\n",
    "    precision = precision_score(y_test, y_pred)\n",
    "    recall = recall_score(y_test, y_pred)\n",
    "    f1 = f1_score(y_test, y_pred)\n",
    "    f2 = fbeta_score(y_test, y_pred, beta=2) # F2 Score focuses heavily on Recall\n",
    "    \n",
    "    print(\"================ MODEL PERFORMANCE METRICS ================\")\n",
    "    print(f\" Accuracy:  {accuracy*100:.2f}%\")\n",
    "    print(f\" recision: {precision*100:.2f}%\")\n",
    "    print(f\" Recall:    {recall*100:.2f}%\")\n",
    "    print(f\" F1-Score:  {f1*100:.2f}%\")\n",
    "    print(f\" F2-Score:  {f2*100:.2f}%\")\n",
    "    print(\"\\nDetailed Classification Report:\")\n",
    "    print(classification_report(y_test, y_pred, target_names=['Low/Med Satisfaction', 'High Satisfaction']))\n",
    "    \n",
    "\n",
    "    plt.figure(figsize=(14, 5))\n",
    "    \n",
    "    \n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.plot(mlp.loss_curve_, color='#1f77b4', linewidth=2.5, label='Training Loss')\n",
    "    plt.title('ANN Training Loss Curve over Iterations', fontsize=12, fontweight='bold', pad=10)\n",
    "    plt.xlabel('Iterations / Epochs', fontsize=10)\n",
    "    plt.ylabel('Loss Value', fontsize=10)\n",
    "    plt.grid(True, linestyle='--', alpha=0.6)\n",
    "    plt.legend(fontsize=10)\n",
    "    \n",
    "\n",
    "    plt.subplot(1, 2, 2)\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False,\n",
    "                xticklabels=['Predicted Low/Med', 'Predicted High'],\n",
    "                yticklabels=['Actual Low/Med', 'Actual High'], \n",
    "                annot_kws={\"size\": 13, \"weight\": \"bold\"})\n",
    "    plt.title('Confusion Matrix Heatmap (Actual vs Predicted)', fontsize=12, fontweight='bold', pad=10)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()"
